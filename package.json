{
  "name": "local-ocr",
  "version": "0.9.0",
  "private": false,
  "author": "Sam Carrington <sam.carrington@frog.co>",
  "description": "Local OCR tool for PDFs and images, supporting multiple OCR adapters.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:nuxt": "nuxt dev",
    "build": "tsc -p tsconfig.json",
    "build:nuxt": "nuxt build",
    "start": "node dist/src/server.js",
    "start:nuxt": "NODE_ENV=production node .output/server/index.mjs",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.config.server.ts && pnpm check:architecture",
    "test:src": "vitest run --config vitest.config.ts",
    "test:server": "vitest run --config vitest.config.server.ts",
    "check:architecture": "node scripts/check-server-boundaries.mjs",
    "setup:tesseract": "node scripts/download-tessdata.mjs eng ./tessdata",
    "serve:nuextract3": "tsx scripts/serve-nuextract3.ts",
    "serve:glm-ocr": "tsx scripts/serve-glm-ocr.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "@firecrawl/anydoc": "0.1.7",
    "@napi-rs/canvas": "1.0.2",
    "express": "5.2.1",
    "pdfjs-dist": "6.1.200",
    "tesseract.js": "7.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "nuxt": "^4.5.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
