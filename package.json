{
  "name": "local-ocr",
  "version": "0.9.0",
  "private": false,
  "author": "Sam Carrington <sam.carrington@frog.co>",
  "description": "Local OCR tool for PDFs and images, supporting multiple OCR adapters.",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "setup:tesseract": "node scripts/download-tessdata.mjs eng ./tessdata",
    "serve:nuextract3": "tsx scripts/serve-nuextract3.ts",
    "serve:glm-ocr": "tsx scripts/serve-glm-ocr.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.2",
    "express": "5.2.1",
    "pdfjs-dist": "6.1.200",
    "tesseract.js": "7.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
