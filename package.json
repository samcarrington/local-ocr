{
  "name": "local-ocr",
  "version": "0.9.0",
  "private": false,
  "author": "Sam Carrington <sam.carrington@frog.co>",
  "description": "Local OCR tool for PDFs and images, supporting multiple OCR adapters.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "dev:nuxt": "nuxt dev",
    "build": "tsc -p tsconfig.json",
    "build:nuxt": "nuxt build",
    "start": "NODE_ENV=production node .output/server/index.mjs",
    "start:nuxt": "NODE_ENV=production node .output/server/index.mjs",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.config.server.ts && pnpm check:architecture",
    "test:src": "vitest run --config vitest.config.ts",
    "test:server": "vitest run --config vitest.config.server.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage.enabled && vitest run --config vitest.config.server.ts --coverage.enabled",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/check-server-boundaries.mjs",
    "setup:tesseract": "node scripts/download-tessdata.mjs eng ./tessdata",
    "serve:mlx-vlm": "tsx scripts/serve-mlx-vlm.ts",
    "start:glm-ocr": "tsx scripts/start-glm-ocr.ts",
    "benchmark:ocr": "tsx scripts/benchmark-ocr.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "@firecrawl/anydoc": "0.1.7",
    "@napi-rs/canvas": "1.0.2",
    "dompurify": "3.4.13",
    "marked": "18.0.9",
    "pdfjs-dist": "6.1.200",
    "tesseract.js": "7.0.0",
    "vue": "3.5.41",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "nuxt": "^4.5.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
