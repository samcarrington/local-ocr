{
  "name": "local-ocr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "setup:tesseract": "node scripts/download-tessdata.mjs eng ./tessdata",
    "serve:nuextract3": "tsx scripts/serve-nuextract3.ts",
    "serve:glm-ocr": "tsx scripts/serve-glm-ocr.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "express": "^4.21.2",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1",
    "yaml": "^2.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
